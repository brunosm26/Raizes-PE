# Copie este arquivo para .env. O .env NAO vai para o GitHub.
#   Windows (cmd):   copy .env.example .env
#   Mac/Linux:       cp .env.example .env

# Porta do servidor (padrao 4000, para nao conflitar com o Next na 3000).
PORT=4000

# Ambiente: development, production ou test.
NODE_ENV=development

# --- Banco (Neon) ------------------------------------------------------------
# Pegue as duas no painel do Neon (Connect). Ambas terminam em ?sslmode=require.
# DATABASE_URL: connection string POOLED (host com "-pooler"), usada pelo app em runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
# DIRECT_URL: connection string DIRETA (host sem "-pooler"), usada so pela CLI do Prisma (db pull).
DIRECT_URL=postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/BANCO?sslmode=require

# Segredo que assina o JWT do cookie de sessao (HS256): o MESMO valor do SESSION_SECRET do
# front (32+ caracteres), para o middleware.ts do Next aceitar o cookie emitido pela API.
SESSION_SECRET=

# Testes que gravam no banco (npm test): a TEST_DATABASE_URL NAO vai neste arquivo (os testes
# nao o leem para ela). Defina no terminal, apontando para um banco DESCARTAVEL, nunca o Neon do time:
#   cmd:         set TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/raizes_teste
#   PowerShell:  $env:TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/raizes_teste"
#   Mac/Linux:   export TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/raizes_teste
# Host remoto (ex.: uma branch do Neon so para testes) exige tambem TEST_DB_REMOTO_DESCARTAVEL=1.

# --- Front em outra origem (PI4-132) ---------------------------------------
# Nao precisa quando o front chama a API pelo proxy do Next (BACKEND_URL no .env.local da raiz).
# So para o navegador chamar a API direto, em outra origem:
# CORS_ORIGIN: origens do front liberadas por CORS, com cookies; varias separadas por virgula.
#   CORS_ORIGIN=http://localhost:3000
# COOKIE_SAMESITE: lax (padrao), strict ou none. "none" (front e API em dominios diferentes, so com
# HTTPS) forca o cookie Secure.
#   COOKIE_SAMESITE=none
# (O JWT da PI4-130 usa o SESSION_SECRET acima; nao existe JWT_SECRET.)
