# Copie este arquivo para .env. O .env NAO vai para o GitHub.
#   Windows (cmd):   copy .env.example .env
#   Mac/Linux:       cp .env.example .env

# Porta do servidor (padrao 4000, para nao conflitar com o Next na 3000).
PORT=4000

# Ambiente: development, production ou test.
NODE_ENV=development

# --- Banco (Neon) ------------------------------------------------------------
# Pegue as duas no painel do Neon (Connect). Ambas terminam em ?sslmode=require.
# DATABASE_URL: connection string POOLED (host com "-pooler"), usada pelo app em runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
# DIRECT_URL: connection string DIRETA (host sem "-pooler"), usada so pela CLI do Prisma (db pull).
DIRECT_URL=postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/BANCO?sslmode=require

# --- Variaveis futuras (cada uma entra com o seu card) ---------------------
# JWT_SECRET=
# CORS_ORIGIN=http://localhost:3000
