# Copie este arquivo para .env. O .env NAO vai para o GitHub.
#   Windows (cmd):   copy .env.example .env
#   Mac/Linux:       cp .env.example .env

# Porta do servidor (padrao 4000, para nao conflitar com o Next na 3000).
PORT=4000

# Ambiente: development, production ou test.
NODE_ENV=development

# Connection string do Neon (a mesma do .env.local do front).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Segredo do cookie de sessao: o MESMO valor do SESSION_SECRET do front (32+ caracteres),
# para o middleware.ts do Next aceitar o cookie emitido pela API.
SESSION_SECRET=

# Testes que gravam no banco (npm test): use um banco DESCARTAVEL, nunca o Neon do time.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/raizes_teste

# --- Variaveis futuras (cada uma entra com o seu card) ---------------------
# JWT_SECRET=
# CORS_ORIGIN=http://localhost:3000
