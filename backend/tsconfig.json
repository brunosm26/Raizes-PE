{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // ".." porque test/tokenSessao.test.ts importa lib/sessao.ts do front. O build usa
    // tsconfig.build.json (rootDir src).
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "prisma.config.ts"]
}
