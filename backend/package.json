{
  "name": "raizes-pe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do Raízes PE (Express + TypeScript)",
  "main": "dist/server.js",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "preprisma:generate": "node -e \"require('fs').rmSync('src/generated', { recursive: true, force: true })\"",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:verificar": "tsx scripts/verificar-prisma.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
