# Copie este arquivo para .env.local. O .env.local NAO vai para o GitHub.
#   Windows (cmd):   copy .env.example .env.local
#   Mac/Linux:       cp .env.example .env.local

# --- Banco de dados ---------------------------------------------------------
# Opcao A (padrao do time): PostgreSQL local do docker-compose.yml (npm run db:up).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/origem

# Opcao B: banco na nuvem (Neon). Troque a linha acima por algo como:
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# --- Sessao de login ---------------------------------------------------------
# Segredo que assina o cookie de sessao (minimo 32 caracteres). Cada pessoa gera o seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
